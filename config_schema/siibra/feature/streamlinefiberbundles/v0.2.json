{
    "$schema": "http://json-schema.org/draft-07/schema",
    "allOf": [{
        "$ref": "/config_schema/geometry_base.json"
    }],
    "properties": {
        "@type": {
            "const": "siibra/feature/streamlinefiberbundles/v0.2"
        },
        "providers": {
            "description": "TRX: one file, whose groups are the bundles. TRK: one file, or one per bundle.",
            "type": "object",
            "minProperties": 1,
            "properties": {
                "trx": {
                    "$ref": "/config_schema/geometry_base.json#/definitions/source"
                },
                "trk": {
                    "$ref": "/config_schema/geometry_base.json#/definitions/fragmentedSource"
                }
            },
            "additionalProperties": false
        }
    }
}
