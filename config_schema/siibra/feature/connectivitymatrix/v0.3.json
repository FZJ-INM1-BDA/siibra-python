{
    "$schema": "http://json-schema.org/draft-07/schema",
    "allOf": [{
        "$ref": "/config_schema/has_ebrainsrefs.json"
    }],
    "properties": {
        "@type": {
            "const": "siibra/feature/connectivitymatrix/v0.3"
        },
        "repository": {
            "anyOf": [{
                "$ref": "/config_schema/siibra/repository/zippedfile/v1.0.0.json"
            }, {
                "$ref": "/config_schema/siibra/repository/dataproxy/v1.0.0.json"
            }]
        },
        "files": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "string"
            }
        },
        "modality": {
            "$ref": "#/definitions/connectivityModalities"
        },
        "paradigm": {
            "type": "string"
        },
        "parcellation": {
            "$ref": "/config_schema/at_id.json"
        },
        "regions": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "files_indexed_by": {
            "type": "string"
        }
    },
    "required": [
        "repository",
        "files"
    ],
    "definitions": {
        "connectivityModalities": {
            "anyOf": [
                {"const": "StreamlineCounts"},
                {"const": "FunctionalConnectivity"},
                {"const": "AnatomoFunctionalConnectivity"},
                {"const": "StreamlineLengths"},
                {"const": "TracingConnectivity"}
            ]
        }
    }
}
