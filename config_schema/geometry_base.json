{
    "$schema": "http://json-schema.org/draft-07/schema",
    "allOf": [{
        "$ref": "/config_schema/has_ebrainsrefs.json"
    }],
    "properties": {
        "name": {
            "type": "string"
        },
        "modality": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "prerelease": {
            "type": "boolean"
        },
        "species": {
            "type": "string"
        },
        "space": {
            "$ref": "/config_schema/at_id.json"
        },
        "parcellation": {
            "$ref": "/config_schema/at_id.json"
        },
        "fragment_regions": {
            "description": "Links fragments to regions of the parcellation: the URL of a table with one row per fragment (named in the first column), one column per region name and 1 where linked; or a mapping of fragment names to region names.",
            "anyOf": [{
                "type": "string"
            }, {
                "type": "object",
                "patternProperties": {
                    ".+": {
                        "anyOf": [{
                            "type": "string"
                        }, {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }]
                    }
                }
            }]
        },
        "affine": {
            "description": "Optional 4x4 affine mapping stored coordinates into the space, for data that is not stored in it.",
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                    "type": "number"
                }
            }
        }
    },
    "definitions": {
        "source": {
            "type": "string"
        },
        "fragmentedSource": {
            "description": "One source, or a mapping of fragment names to sources.",
            "anyOf": [{
                "type": "string"
            }, {
                "type": "object",
                "minProperties": 1,
                "patternProperties": {
                    ".+": {
                        "type": "string"
                    }
                }
            }]
        }
    },
    "required": [
        "@type",
        "modality",
        "space",
        "parcellation",
        "providers"
    ]
}
